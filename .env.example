# Laminario configuration. Copy to .env for local development (scripts/local/01_init does it).
# Every variable is optional locally; production values live in the server's environment file.

# development | production
LAMINARIO_ENV=development

# The address people reach the app at. Permalinks and QR codes are built from it.
LAMINARIO_PUBLIC_BASE_URL=http://127.0.0.1:8147

# Root of the slide store, upload quarantine, tile cache and database.
# Local default: .data/ inside the repository (git ignores it). Production: /srv/laminario
LAMINARIO_DATA_ROOT=

# Where tests write their temporary files. Default: .tmp/pytest inside the repository.
LAMINARIO_TEST_TMP=

# Windows only: the bin folder of the official libvips build that includes OpenSlide (vips-dev-x64-all).
# Unset on Linux, where the system libvips is found on its own.
LAMINARIO_VIPS_BIN=

# The local data vault with the imaging fixtures: samples/ (slide files) and edf-reference/ (the EPFL
# plugin's reference stacks and outputs). Tests that need them are skipped when unset.
LAMINARIO_FIXTURES=

# The world basemap written by scripts/fetch_basemap.py (a PMTiles file of 188 MB, outside the repository).
# Unset: the map draws the countries without a basemap.
LAMINARIO_BASEMAP=

# Signs password-reset links. Required in production (from the vault); locally, unset means a random key per run.
LAMINARIO_SECRET_KEY=

# Optional mail sender (SMTP with STARTTLS on 587). Unset: invitation and reset links are shown to the issuer.
LAMINARIO_SMTP_HOST=
LAMINARIO_SMTP_PORT=587
LAMINARIO_SMTP_USERNAME=
LAMINARIO_SMTP_PASSWORD=
LAMINARIO_SMTP_SENDER=

# Tests only: the tusd binary (v2.10.1) the upload tests start. Production runs deploy/tusd/compose.yaml.
LAMINARIO_TUSD_BIN=
