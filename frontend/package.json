{
  "name": "laminario-web",
  "private": true,
  "version": "0.17.3",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --port 5909 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4909 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "contract:generate": "node scripts/generate-contract-types.mjs",
    "contract:check": "node scripts/check-contract-drift.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gate:fit": "node gates/fit.mjs",
    "gate:motion": "node gates/motion.mjs",
    "gate:states": "node gates/states.mjs",
    "gate:walk": "node gates/walk.mjs",
    "gate:qr": "node gates/qr.mjs",
    "gate:scalebar": "node gates/scalebar.mjs",
    "gate:stage": "node gates/stage.mjs",
    "gate:contribute": "node gates/contribute.mjs",
    "gate:identify": "node gates/identify.mjs",
    "gate:cabinet": "node gates/cabinet.mjs",
    "gate:about": "node gates/about.mjs",
    "gate:links": "node gates/links.mjs",
    "gate:production": "node gates/production.mjs",
    "gate:glass": "node gates/glass.mjs",
    "gate:glass-look": "node gates/glass-look.mjs"
  },
  "dependencies": {
    "@annotorious/openseadragon": "3.9.3",
    "@protomaps/basemaps": "5.7.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@uppy/core": "6.1.0",
    "@uppy/tus": "6.0.0",
    "exifr": "7.1.3",
    "katex": "0.18.9",
    "maplibre-gl": "6.11.2",
    "openseadragon": "6.1.1",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "wouter": "3.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "json-schema-to-typescript": "16.0.0",
    "jsqr": "1.4.0",
    "playwright": "^1.63.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
