{
  "name": "laminario-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --port 5909 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4909 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "contract:generate": "node scripts/generate-contract-types.mjs",
    "contract:check": "node scripts/check-contract-drift.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gate:fit": "node gates/fit.mjs",
    "gate:motion": "node gates/motion.mjs",
    "gate:states": "node gates/states.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
