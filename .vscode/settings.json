{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.exclude": ["**/.venv*/**", "**/node_modules/**", "**/frontend/dist/**", "**/.data/**", "**/.tmp/**"],
  "files.watcherExclude": {
    "**/.venv*/**": true,
    "**/node_modules/**": true,
    "**/frontend/dist/**": true,
    "**/__pycache__/**": true,
    "**/.data/**": true,
    "**/.tmp/**": true
  },
  "search.exclude": {"**/.venv*": true, "**/node_modules": true, "**/frontend/dist": true, "**/.data": true, "**/.tmp": true}
}
