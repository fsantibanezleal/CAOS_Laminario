# /etc/fasl-laminario.env on the production host (mode 0640, root:laminario). The real values live in the
# management repository's vault; this file names them.
LAMINARIO_PUBLIC_BASE_URL=https://laminario.ml.fasl-work.com
LAMINARIO_DATA_ROOT=/srv/laminario
LAMINARIO_SECRET_KEY=
LAMINARIO_IIPSRV_URL=http://127.0.0.1:8149
LAMINARIO_TUSD_URL=http://127.0.0.1:8148
LAMINARIO_BASEMAP=/srv/laminario/basemap/world-z7-20260928.pmtiles
# Optional: the mail sender. Without it, invitation and reset links are printed on the command line.
LAMINARIO_SMTP_HOST=
LAMINARIO_SMTP_SENDER=
