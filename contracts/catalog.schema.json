{
  "$id": "https://laminario.ml.fasl-work.com/contracts/catalog.schema.json",
  "title": "LaminarioCatalog",
  "type": "object",
  "properties": {
    "slide": {
      "$ref": "#/$defs/SlideRecord"
    },
    "slidePage": {
      "$ref": "#/$defs/SlidePage"
    },
    "slideSummary": {
      "$ref": "#/$defs/SlideSummary"
    },
    "validation": {
      "$ref": "#/$defs/ValidationResult"
    },
    "job": {
      "$ref": "#/$defs/JobRecord"
    },
    "jobEvent": {
      "$ref": "#/$defs/JobEventRecord"
    },
    "account": {
      "$ref": "#/$defs/AccountRecord"
    },
    "invitation": {
      "$ref": "#/$defs/InvitationRecord"
    },
    "createdSlideCase": {
      "$ref": "#/$defs/CreatedSlideCase"
    },
    "upload": {
      "$ref": "#/$defs/UploadRecord"
    },
    "collectionTree": {
      "$ref": "#/$defs/CollectionTreeRecord"
    },
    "collectionNode": {
      "$ref": "#/$defs/CollectionNodeDetail"
    },
    "facet": {
      "$ref": "#/$defs/FacetRecord"
    },
    "anchorSuggestion": {
      "$ref": "#/$defs/AnchorSuggestion"
    },
    "placement": {
      "$ref": "#/$defs/PlacementResult"
    },
    "facetCounts": {
      "$ref": "#/$defs/FacetCounts"
    },
    "map": {
      "$ref": "#/$defs/MapRecord"
    },
    "annotation": {
      "$ref": "#/$defs/AnnotationRecord"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AccountRecord": {
      "additionalProperties": false,
      "description": "An account as ``GET /api/users/me`` returns it.",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "contributor",
            "identifier",
            "curator",
            "admin"
          ],
          "type": "string"
        },
        "is_active": {
          "type": "boolean"
        },
        "is_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "email",
        "display_name",
        "role",
        "is_active",
        "is_verified"
      ],
      "title": "AccountRecord",
      "type": "object"
    },
    "AnchorRecord": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "taxon",
            "rock",
            "mineral",
            "crystal",
            "material"
          ],
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "classification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "ref",
        "name"
      ],
      "title": "AnchorRecord",
      "type": "object"
    },
    "AnchorSuggestion": {
      "additionalProperties": false,
      "description": "A name the anchor field can offer (``GET /api/anchors/search``).",
      "properties": {
        "ref": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "classification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ref",
        "name"
      ],
      "title": "AnchorSuggestion",
      "type": "object"
    },
    "AnnotationRecord": {
      "additionalProperties": false,
      "description": "An annotation as the stage reads it: the W3C Web Annotation, who wrote it, and whether the reader may remove\nit (its author, or a curator).",
      "properties": {
        "id": {
          "type": "string"
        },
        "asset_id": {
          "type": "integer"
        },
        "author": {
          "type": "string"
        },
        "removable": {
          "default": false,
          "type": "boolean"
        },
        "annotation": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "id",
        "asset_id",
        "author",
        "annotation"
      ],
      "title": "AnnotationRecord",
      "type": "object"
    },
    "AssetRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "family": {
          "enum": [
            "macro",
            "micro"
          ],
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sort_order": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "failed"
          ],
          "type": "string"
        },
        "media": {
          "$ref": "#/$defs/MediaRecord"
        },
        "pixel_size_um": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plane": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaneRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "polarisation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolarisationRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "licence": {
          "$ref": "#/$defs/LicenceRecord"
        },
        "rights_holder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "creator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "family",
        "role",
        "sort_order",
        "status",
        "media",
        "licence"
      ],
      "title": "AssetRecord",
      "type": "object"
    },
    "CellRecord": {
      "additionalProperties": false,
      "properties": {
        "south": {
          "type": "number"
        },
        "west": {
          "type": "number"
        },
        "north": {
          "type": "number"
        },
        "east": {
          "type": "number"
        }
      },
      "required": [
        "south",
        "west",
        "north",
        "east"
      ],
      "title": "CellRecord",
      "type": "object"
    },
    "CollectionNodeDetail": {
      "additionalProperties": false,
      "description": "One node (``GET /api/collections/{id}``): itself with its children, and the path down to it.",
      "properties": {
        "node": {
          "$ref": "#/$defs/CollectionNodeRecord"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/NodeRef"
          },
          "type": "array"
        },
        "iiif_collection_url": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "path",
        "iiif_collection_url"
      ],
      "title": "CollectionNodeDetail",
      "type": "object"
    },
    "CollectionNodeRecord": {
      "additionalProperties": false,
      "description": "A node of the collection tree (``GET /api/collections``), with its published slides counted.",
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "enum": [
            "realm",
            "collection",
            "sub-collection",
            "group"
          ],
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/LocalisedText"
        },
        "about": {
          "$ref": "#/$defs/LocalisedText"
        },
        "icon": {
          "type": "string"
        },
        "view": {
          "default": false,
          "type": "boolean"
        },
        "priority": {
          "default": 0,
          "type": "integer"
        },
        "defined_by": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DefinitionRecord"
          },
          "type": "array"
        },
        "slide_count": {
          "default": 0,
          "type": "integer"
        },
        "children": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CollectionNodeRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "level",
        "name",
        "about",
        "icon"
      ],
      "title": "CollectionNodeRecord",
      "type": "object"
    },
    "CollectionTreeRecord": {
      "additionalProperties": false,
      "description": "The whole tree: the three realms and everything under them.",
      "properties": {
        "realms": {
          "items": {
            "$ref": "#/$defs/CollectionNodeRecord"
          },
          "type": "array"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "realms",
        "counts"
      ],
      "title": "CollectionTreeRecord",
      "type": "object"
    },
    "CoverslipRecord": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "long_mm": {
          "type": "number"
        },
        "short_mm": {
          "type": "number"
        }
      },
      "required": [
        "code",
        "long_mm",
        "short_mm"
      ],
      "title": "CoverslipRecord",
      "type": "object"
    },
    "CreatedSlideCase": {
      "additionalProperties": false,
      "description": "The answer of ``POST /api/slide-cases``: the new draft and the flags of its submission.",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValidationFlag"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "CreatedSlideCase",
      "type": "object"
    },
    "DefinitionRecord": {
      "additionalProperties": false,
      "description": "One condition of a node's rule, for people: a taxon with its GBIF page, a rock family, a part.",
      "properties": {
        "kind": {
          "enum": [
            "taxon",
            "excluded-taxon",
            "kind",
            "rock",
            "mineral",
            "crystal",
            "material",
            "part",
            "preservation",
            "relation"
          ],
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "value",
        "label"
      ],
      "title": "DefinitionRecord",
      "type": "object"
    },
    "FacetCounts": {
      "additionalProperties": false,
      "description": "For each facet, its values under the current filters and how many slides each would match (the facet's own\nfilter left out, so a second value shows what it adds).",
      "properties": {
        "collection": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "kind": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "preparation": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "modality": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "preservation": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "country": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "licence": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "wsi": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "origin": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        }
      },
      "title": "FacetCounts",
      "type": "object"
    },
    "FacetRecord": {
      "additionalProperties": false,
      "description": "A property that cuts across the tree, with the icon of each value.",
      "properties": {
        "id": {
          "enum": [
            "preparation",
            "modality",
            "plant-organ",
            "crystal-system"
          ],
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/LocalisedText"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/FacetValueRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "values"
      ],
      "title": "FacetRecord",
      "type": "object"
    },
    "FacetValueRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/LocalisedText"
        },
        "icon": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "icon"
      ],
      "title": "FacetValueRecord",
      "type": "object"
    },
    "FormatRecord": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "width_mm": {
          "type": "number"
        },
        "height_mm": {
          "type": "number"
        },
        "assumed": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "width_mm",
        "height_mm"
      ],
      "title": "FormatRecord",
      "type": "object"
    },
    "InvitationRecord": {
      "additionalProperties": false,
      "description": "An invitation as its issuer sees it. ``link`` is present only in the answer that created it, and only\nwhen it was not mailed: the token is never stored, so it cannot be shown again.",
      "properties": {
        "id": {
          "type": "integer"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "enum": [
            "contributor",
            "identifier",
            "curator",
            "admin"
          ],
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "pending",
            "used",
            "expired",
            "revoked"
          ],
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "mailed": {
          "type": "boolean"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "role",
        "status",
        "created_at",
        "expires_at",
        "mailed"
      ],
      "title": "InvitationRecord",
      "type": "object"
    },
    "JobEventRecord": {
      "additionalProperties": false,
      "description": "One Server-Sent Event of a job's stream: its ``id`` field is ``seq``, its ``event`` field ``event``.",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "event": {
          "enum": [
            "queued",
            "started",
            "progress",
            "log",
            "requeued",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "type": "object"
        },
        "at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "event",
        "data",
        "at"
      ],
      "title": "JobEventRecord",
      "type": "object"
    },
    "JobRecord": {
      "additionalProperties": false,
      "description": "A processing job as ``GET /api/jobs/{id}`` returns it.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        "attempts": {
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "events_url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "attempts",
        "created_at",
        "events_url"
      ],
      "title": "JobRecord",
      "type": "object"
    },
    "LabelRecord": {
      "additionalProperties": false,
      "description": "What the printed label shows.",
      "properties": {
        "name": {
          "type": "string"
        },
        "catalogue_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preparation": {
          "type": "string"
        },
        "stain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mountant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prepared_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preparer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collected_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "locality_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "preparation"
      ],
      "title": "LabelRecord",
      "type": "object"
    },
    "LicenceRecord": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "short_name"
      ],
      "title": "LicenceRecord",
      "type": "object"
    },
    "LocalisedText": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        }
      },
      "required": [
        "en",
        "es"
      ],
      "title": "LocalisedText",
      "type": "object"
    },
    "MapPointRecord": {
      "additionalProperties": false,
      "description": "A slide on the map, after geoprivacy: an obscured one at its public point, with its 0.2 degree cell.",
      "properties": {
        "id": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "obscured": {
          "default": false,
          "type": "boolean"
        },
        "cell": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "lat",
        "lon"
